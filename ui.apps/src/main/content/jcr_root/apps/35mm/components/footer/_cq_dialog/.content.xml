<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="Footer"
          sling:resourceType="cq/gui/components/authoring/dialog">
    <content
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <footerLink
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                            fieldLabel="Footer Text"
                            name="./footerText"/>
                    <companyLogo jcr:primaryType="nt:unstructured"
                          sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                          fieldLabel="Company Logo"
                          name="./file"
                          fileNameParameter="./fileName"
                          fileReferenceParameter="./companyLogo"
                          mimeTypes="[image/gif,image/jpeg,image/png,image/webp]"
                          allowUpload="{Boolean}true"
                          multiple="{Boolean}false"/>
                </items>
            </column>
            <tabs
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/tabs"
                    maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <properties
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Propiedades"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column1
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <legalLinks jcr:primaryType="nt:unstructured"
                                                     sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                     fieldLabel="Legal Links"
                                                     composite="{Boolean}true">
                                                <granite:data jcr:primaryType="nt:unstructured" max-item="4" min-item="1"/>
                                                <field jcr:primaryType="nt:unstructured"
                                                       sling:resourceType="granite/ui/components/coral/foundation/container"
                                                       name="./legalLinks"
                                                >
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <legalLinkText jcr:primaryType="nt:unstructured"
                                                                         sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                         fieldLabel="Legal Link Text"
                                                                         name="./legalLinkText"/>
                                                        <legalLink jcr:primaryType="nt:unstructured"
                                                                     sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                     fieldLabel="Legal Link"
                                                                     name="./legalLink"/>
                                                    </items>
                                                </field>
                                            </legalLinks>
                                        </items>
                                    </column1>
                                    <column2
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <helpNavigation jcr:primaryType="nt:unstructured"
                                                     sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                     fieldLabel="Help Navigation"
                                                     composite="{Boolean}true">
                                                <granite:data jcr:primaryType="nt:unstructured" max-item="4" min-item="1"/>
                                                <field jcr:primaryType="nt:unstructured"
                                                       sling:resourceType="granite/ui/components/coral/foundation/container"
                                                       name="./helpNavigation"
                                                >
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <helpNavigationText jcr:primaryType="nt:unstructured"
                                                                     sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                     fieldLabel="Help Navigation Text"
                                                                     name="./helpNavigationText"/>
                                                        <helpNavigationLink jcr:primaryType="nt:unstructured"
                                                                   sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                   fieldLabel="Help Navigation Link"
                                                                   name="./helpNavigationLink"/>
                                                    </items>
                                                </field>
                                            </helpNavigation>
                                        </items>
                                    </column2>
                                    <column3
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <redesSociales jcr:primaryType="nt:unstructured"
                                                           sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                           fieldLabel="Redes Sociales"
                                                           composite="{Boolean}true">
                                                <granite:data jcr:primaryType="nt:unstructured"/>
                                                <field jcr:primaryType="nt:unstructured"
                                                       sling:resourceType="granite/ui/components/coral/foundation/container"
                                                       name="./redesSociales"
                                                >
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <link
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                fieldLabel="Enlace de la red social"
                                                                name="./link"/>
                                                        <file jcr:primaryType="nt:unstructured"
                                                              sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                                              fieldLabel="Icono de la red social"
                                                              name="./file"
                                                              fileNameParameter="./fileName"
                                                              fileReferenceParameter="./fileReference"
                                                              mimeTypes="[image/gif,image/jpeg,image/png,image/webp]"
                                                              allowUpload="{Boolean}true"
                                                              multiple="{Boolean}false"/>
                                                    </items>
                                                </field>
                                            </redesSociales>
                                        </items>
                                    </column3>
                                </items>
                            </columns>
                        </items>
                    </properties>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
